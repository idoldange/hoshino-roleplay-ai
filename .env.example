# Copy file nay thanh .env roi dien gia tri thuc.
# Luu bang UTF-8 KHONG BOM (Notepad: Save as -> UTF-8, hoac "All files" de
# tranh BOM lam key dau tien bi doc sai).
DISCORD_TOKEN=
# ID kenh nhan thong bao bat/tat bot (0 = tat)
STATUS_CHANNEL_ID=0
LM_BASE_URL=https://localhost:1234/v1
LM_API_KEY=sk-iamoptimusprime676767skibiditoilet
MODEL_NAME=huihui/gemma4-12b-it-abliterated
# Danh sach model cho lenh !hoshino model; moi user tu chon model rieng.
# multimodal=true: gui anh cho model; false: thay anh bang note text.
# description: dong mo ta ngan hien trong dropdown (toi da 100 ky tu).
MODEL_LIST={"Roleplay": {"id": "imgxh/roleplay", "multimodal": true, "description": "Nhận ảnh"}, "Gemma 12B": {"id": "huihui/gemma4-12b-it-abliterated", "multimodal": false, "description": "Chỉ text"}}
